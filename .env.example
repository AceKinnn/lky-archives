# Copy to .env.local and fill in. All of these are server-only: never add a
# NEXT_PUBLIC_ prefix, and never commit the real values.

# Answers and Prompt Guard (https://console.groq.com)
GROQ_API_KEY=
# Optional: a different Groq model if the default is retired
LKY_MODEL=

# Question embeddings (https://dashboard.cohere.com)
COHERE_API_KEY=

# Passage search (Supabase project settings > API)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Lets only Vercel Cron call /api/keep-alive (any long random string)
CRON_SECRET=
